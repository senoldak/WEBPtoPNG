{
  "manifest_version": 3,
  "name": "WebP - PNG Converter",
  "version": "2.0.0",
  "description": "Convert WebP images to PNG, JPEG, WEBP, or BMP online & offline. Includes batch ZIP, resizing, and copy to clipboard.",
  "permissions": [
    "contextMenus",
    "downloads",
    "offscreen",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebP - PNG Converter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
